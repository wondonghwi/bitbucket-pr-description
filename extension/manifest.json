{
  "manifest_version": 3,
  "name": "Bitbucket PR Description",
  "version": "0.1.1",
  "description": "Keep the pull request description beside the diff. No tokens, accounts, or tracking.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
