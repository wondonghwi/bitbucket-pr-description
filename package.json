{
  "name": "bitbucket-pr-description",
  "version": "0.1.0",
  "private": true,
  "description": "Read Bitbucket pull request descriptions beside your code review.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "check": "pnpm format:check && pnpm test && pnpm build",
    "format:check": "prettier --check src scripts tests extension docs/*.html *.json *.md",
    "package": "pnpm check && node scripts/package.js",
    "demo": "pnpm build && node scripts/demo.js"
  },
  "dependencies": {
    "dompurify": "^3.4.16"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
